# SmartBill AI Configuration
PROJECT_NAME="SmartBill AI"
PORT=8000

# Gemini API Key (Vision Document AI)
# Get your free key at https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Database Configuration (SQLite default; PostgreSQL supported e.g. postgresql://user:password@localhost/smartbill)
DATABASE_URL="sqlite:///./smartbill.db"

# Preferences
DEFAULT_CURRENCY="INR"
MAX_FILE_SIZE_MB=25
