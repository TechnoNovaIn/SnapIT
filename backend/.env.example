# SnapIT backend configuration. Copy to backend/.env (which is git-ignored) and fill in.
PROJECT_NAME="SnapIT"
PORT=8000

# Gemini API key for vision extraction (get a free key at https://aistudio.google.com).
# Leave empty to use the local OCR engine. The key can also be set from the app's Settings screen.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Database: SQLite by default; PostgreSQL also works, e.g. postgresql://user:password@localhost/smartbill
# DATABASE_URL="sqlite:///./smartbill.db"

# Where uploaded documents are stored (default: backend/uploads)
# SNAPIT_UPLOAD_DIR=""

# Browser origins allowed to call the API. "*" (default) is fine for local use; restrict it when exposing the server.
# CORS_ORIGINS="https://your-domain.example"

# Preferences
DEFAULT_CURRENCY="INR"
MAX_FILE_SIZE_MB=25
